# Paracore — static analysis.
#
# We care about concurrency and about bugs the sanitizer only sees if it
# happens to run the right interleaving. The style checks are off;
# .clang-format owns the style.
#
# C++-specific compared with the C version: cppcoreguidelines and modernize
# are on, but heavily trimmed. The two that actually pay for themselves here
# are cppcoreguidelines-avoid-non-const-global-variables (the canaries get an
# exemption) and modernize-use-nullptr.
Checks: >
  -*,
  bugprone-*,
  concurrency-*,
  clang-analyzer-*,
  cert-*,
  misc-*,
  performance-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-equals-default,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  readability-inconsistent-declaration-parameter-name,
  -bugprone-easily-swappable-parameters,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -cert-dcl37-c,
  -cert-dcl51-cpp
WarningsAsErrors: 'concurrency-*,bugprone-signal-handler,clang-analyzer-core.*'
HeaderFilterRegex: '(core|sync|exec|ds|mem|bench|include)/.*\.hpp$'
